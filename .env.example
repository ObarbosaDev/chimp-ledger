# Copie para .env. Os valores abaixo batem com o docker-compose.yml.

# Usuário com DDL, usado só pelas migrações.
MIGRATOR_DATABASE_URL=postgres://chimp_migrator:chimp_migrator@localhost:5432/chimp_ledger
# Usuário da aplicação: sem UPDATE/DELETE no ledger (criado pela migração).
DATABASE_URL=postgres://chimp_app:chimp_app@localhost:5432/chimp_ledger

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

HTTP_PORT=3000
LOG_LEVEL=info
AUTH_ENABLED=false
