{
  "name": "chimp-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Processador de apostas distribuídas: carteira, ledger encadeado, inbox/outbox e SQS.",
  "type": "module",
  "scripts": {
    "start:api": "bun src/main.api.ts",
    "start:worker": "bun src/main.worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:unit": "bun test test/unit test/architecture",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun test/load/run.ts",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1173.0",
    "@mikro-orm/core": "6",
    "@mikro-orm/migrations": "6",
    "@mikro-orm/postgresql": "6",
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/platform-fastify": "11",
    "decimal.js": "10",
    "fastify": "5",
    "jose": "^6.2.18",
    "pg": "8",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3"
  },
  "devDependencies": {
    "@biomejs/biome": "2",
    "@testcontainers/localstack": "^12.2.2",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/bun": "^1.4.5",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.2",
    "typescript": "5"
  }
}
